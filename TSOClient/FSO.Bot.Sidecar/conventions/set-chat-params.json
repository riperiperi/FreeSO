{
  "convention": "freeso-embodiment",
  "version": "1.0",
  "operation": "set-chat-params",
  "family": "social",
  "description": "Update your chat color and TTS pitch as broadcast to other clients. Persistent per-session; not a motive-affecting action.",
  "args": [],
  "produces_tags": [
    {
      "tag": "freeso:set-chat-params",
