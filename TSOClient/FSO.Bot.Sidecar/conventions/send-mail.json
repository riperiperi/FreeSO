{
  "convention": "freeso-embodiment",
  "version": "1.0",
  "operation": "send-mail",
  "family": "mail",
  "description": "Send a `MessageItem` letter to another avatar. Persisted server-side; recipient receives via their next `poll-inbox` or real-time push.",
  "args": [],
  "produces_tags": [
    {
      "tag": "freeso:send-mail",
      "cardinality": "exactly_one"
    }
  ],
  "antecedents": "none",
  "signing": "member_key",
  "rate_limit": {
    "max": 30,
    "per": "sender",
    "window": "1m"
  },
  "response": "sync",
  "status": "scaffold"
}
