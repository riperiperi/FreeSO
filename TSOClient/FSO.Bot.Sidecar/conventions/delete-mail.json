{
  "convention": "freeso-embodiment",
  "version": "1.0",
  "operation": "delete-mail",
  "family": "mail",
  "description": "Remove a mail message from your inbox server-side. Sent-by-you mail is client-only deletion.",
  "args": [],
  "produces_tags": [
    {
      "tag": "freeso:delete-mail",
      "cardinality": "exactly_one"
    }
  ],
  "antecedents": "none",
  "signing": "member_key",
  "rate_limit": {
    "max": 30,
    "per": "sender",
    "window": "1m"
  },
  "response": "sync",
  "status": "scaffold"
}
