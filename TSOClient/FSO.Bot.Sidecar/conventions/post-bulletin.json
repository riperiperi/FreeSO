{
  "convention": "freeso-embodiment",
  "version": "1.0",
  "operation": "post-bulletin",
  "family": "city",
  "description": "Post a new message to a neighborhood bulletin board. Two-stage: CAN_POST_MESSAGE \u2192 POST_MESSAGE.",
  "args": [],
  "produces_tags": [
    {
      "tag": "freeso:post-bulletin",
      "cardinality": "exactly_one"
    }
  ],
  "antecedents": "none",
  "signing": "member_key",
  "rate_limit": {
    "max": 30,
    "per": "sender",
    "window": "1m"
  },
  "response": "sync",
  "status": "scaffold"
}
