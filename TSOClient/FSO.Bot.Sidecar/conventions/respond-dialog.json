{
  "convention": "freeso-embodiment",
  "version": "1.0",
  "operation": "respond-dialog",
  "family": "interaction",
  "description": "Answer a modal dialog the VM raised (OK/Yes/No/TextEntry). Required to unblock any Sim behavior that fires `VM.SignalDialog`.",
  "args": [],
  "produces_tags": [
    {
      "tag": "freeso:respond-dialog",
      "cardinality": "exactly_one"
    }
  ],
  "antecedents": "none",
  "signing": "member_key",
  "rate_limit": {
    "max": 30,
    "per": "sender",
    "window": "1m"
  },
  "response": "sync",
  "status": "scaffold"
}
