{
  "convention": "freeso-embodiment",
  "version": "1.0",
  "operation": "set-chat-channel",
  "family": "social",
  "description": "Create/edit a named chat channel on the lot (admin channel 7 is implicit). Affects which Sims can send/view.",
  "args": [],
  "produces_tags": [
    {
      "tag": "freeso:set-chat-channel",
      "cardinality": "exactly_one"
    }
  ],
  "antecedents": "none",
  "signing": "member_key",
  "rate_limit": {
    "max": 30,
    "per": "sender",
    "window": "1m"
  },
  "response": "sync",
  "status": "scaffold"
}
