<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>FSO.AgentBridge</AssemblyName>
    <RootNamespace>FSO.AgentBridge</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.40.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The whole point: the tool surface is called in-process as plain static methods.
         No ModelContextProtocol reference — MCP is for out-of-process agents. -->
    <ProjectReference Include="..\FSO.ModServer\FSO.ModServer.csproj" />
  </ItemGroup>

</Project>
